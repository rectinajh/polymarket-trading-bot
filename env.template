# =============================================================================
# Polymarket AI Trading Bot — environment template
# =============================================================================
# 1. Copy this file:           cp env.template .env
# 2. Fill in the values below.
# 3. .env is git-ignored (see .gitignore). NEVER commit your private key.
# =============================================================================


# -----------------------------------------------------------------------------
# Polymarket — Polygon wallet & CLOB
# -----------------------------------------------------------------------------
# REQUIRED. Private key of the Polygon wallet that will sign orders.
# - For an EOA (MetaMask / hardware wallet exported key): the key of the
#   wallet that holds USDC.e on Polygon.
# - For Magic Link / proxy wallets: the key of the SIGNER, not the proxy
#   address itself (proxy address goes in POLYMARKET_FUNDER below).
# Format: 0x-prefixed 64-hex-char string.
#
# Collateral: Polymarket settles in USDC.e (NOT USDT / DAI / native USDC alone
# for this bot's balance + allowance path). If you only have USDT on Polygon,
# swap to USDC.e first (Uniswap/1inch), then fund this wallet. Also keep a
# little POL/MATIC for gas.
POLYMARKET_PRIVATE_KEY=0xyour_polygon_private_key_here

# OPTIONAL. Address that holds the USDC and receives positions. Required ONLY
# when SIGNATURE_TYPE != 0 (i.e. Magic Link / Gnosis Safe / proxy setups).
# For an EOA, leave this blank — funder defaults to the signer address.
POLYMARKET_FUNDER=

# Signature scheme used by the wallet:
#   0 = EOA / browser wallet (MetaMask, hardware wallet, exported key)
#   1 = Magic Link (Polymarket email-login proxy wallet)
#   2 = Gnosis Safe / browser proxy wallet
# Default: 0 (matches a private key exported from MetaMask).
POLYMARKET_SIGNATURE_TYPE=0

# CLOB API host. Production = https://clob.polymarket.com
POLYMARKET_HOST=https://clob.polymarket.com

# Chain ID. Polygon mainnet = 137. Polymarket has no separate testnet.
POLYMARKET_CHAIN_ID=137

# OPTIONAL. Polygon RPC endpoint used for USDC balance reads and allowance
# transactions. Defaults to https://polygon-rpc.com if unset (rate-limited
# public endpoint — supply your own Alchemy/QuickNode/Infura URL for live use).
POLYGON_RPC_URL=

# OPTIONAL. Override the Gamma API host used for market discovery.
# Default: https://gamma-api.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com


# -----------------------------------------------------------------------------
# LLM — OpenRouter OR Kimi (Moonshot). Both are OpenAI-compatible.
# -----------------------------------------------------------------------------
# Pick one provider:
#   LLM_PROVIDER=kimi        → Moonshot/Kimi (no OpenRouter needed)
#   LLM_PROVIDER=openrouter  → OpenRouter multi-model gateway
#
# If LLM_PROVIDER is unset and MOONSHOT_API_KEY is set (with no OpenRouter key),
# the bot auto-selects kimi.
#
# Kimi key: https://platform.moonshot.cn/console/api-keys  (CN)
#           https://platform.moonshot.ai/                  (intl)
LLM_PROVIDER=kimi
MOONSHOT_API_KEY=your_moonshot_api_key_here
# Optional overrides:
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_BASE_URL=https://api.moonshot.ai/v1
# PRIMARY_MODEL=moonshot-v1-128k
# FALLBACK_MODEL=moonshot-v1-32k
# SENTIMENT_MODEL=moonshot-v1-8k

# OpenRouter (only if LLM_PROVIDER=openrouter): https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_api_key_here


# -----------------------------------------------------------------------------
# Trading mode — DRY RUN BY DEFAULT
# -----------------------------------------------------------------------------
# DRY_RUN=true  → no orders are sent on-chain (paper mode, safe default)
# DRY_RUN=false → REAL orders against REAL USDC. Combine with caution.
#
# LIVE_TRADING_ENABLED is the legacy flag. If DRY_RUN is set, it wins.
# Code reads both via resolve_live_trading_enabled() in settings.py.
DRY_RUN=true
LIVE_TRADING_ENABLED=false

# Optional: allow non-official CLOB/Gamma/RPC hosts (phishing risk — off by default)
# POLYMARKET_ALLOW_CUSTOM_HOSTS=false


# -----------------------------------------------------------------------------
# Cost & safety limits
# -----------------------------------------------------------------------------
# Hard cap on daily LLM spend (USD). The bot halts trading until midnight UTC
# once the cap is hit. Default 10.
DAILY_AI_COST_LIMIT=10.0


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///trading_system.db


# -----------------------------------------------------------------------------
# Ops alerts — Discord (shared webhook with Delphi)
# -----------------------------------------------------------------------------
# Same channel as Delphi; messages are prefixed **[Polymarket]** and username
# "Polymarket Bot" so you can tell them apart.
DELPHI_ALERT_WEBHOOK_URL=

# Optional: push warning-level ops alerts too (default: critical only)
POLYMARKET_DISCORD_ALERT_LEVEL=warning
# POLYMARKET_DISCORD_ALERT_COOLDOWN_S=3600


# -----------------------------------------------------------------------------
# Relayer — gasless redeem for deposit/proxy wallets (signature_type != 0)
# -----------------------------------------------------------------------------
# Create at Polymarket builder settings. RELAYER_API_KEY_ADDRESS = signer EOA
# (same as private key), NOT the funder/deposit wallet.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=


# -----------------------------------------------------------------------------
# P4 RN1 copy-trade — mirror RN1 BUY (no The Odds API)
# L2 (WebSocket + bilateral inventory) still queued — docs/P4_L2_NEXT.md
# -----------------------------------------------------------------------------
# Profile: https://polymarket.com/zh/@RN1
RN1_PROXY_WALLET=0x2005d16a84ceefa912d4e380cd32e7ff827875ea
SPORTS_RN1_COPY_MAX_USDC=1.0
# Daily cap (directional). Priority when full: tennis > props > Will-win.
SPORTS_RN1_MAX_ENTRIES_PER_DAY=3  # 2026-09-19: 10→3 降速观察
# Entry price band (defaults 0.35–0.75; skip lottery tails / near-locks).
SPORTS_RN1_COPY_PRICE_MIN=0.35
SPORTS_RN1_COPY_PRICE_MAX=0.75
# Tighter band for soccer Will-win match markets.
SPORTS_RN1_MW_PRICE_MIN=0.50
SPORTS_RN1_MW_PRICE_MAX=0.70
# Soccer always; ATP/WTA singles on by default (ITF/doubles off).
SPORTS_RN1_ALLOW_TENNIS=true
# SPORTS_RN1_TENNIS_INCLUDE_ITF=false
# SPORTS_RN1_TENNIS_INCLUDE_DOUBLES=false
# Bulk-mirror RN1 open book? Default off — only new BUY trades.
SPORTS_RN1_SYNC_OPEN_POSITIONS=false
# After EXIT FAIL, skip same position for N seconds (except redeemable).
SPORTS_RN1_EXIT_FAIL_COOLDOWN_S=1800
RN1_LOOKBACK_HOURS=6

# Odds API unused in copy mode (optional legacy):
# THE_ODDS_API_KEY=your_the_odds_api_key_here

# Sports experiment / stop-loss / Discord
# POLYMARKET_SPORTS_DISCORD=true
# POLYMARKET_SPORTS_DISCORD_COOLDOWN_S=1800
# SPORTS_EXPERIMENT_DAYS=90
SPORTS_MAX_DAILY_LOSS_PCT=0.02  # 2026-09-19: 0.05→0.02 降速观察
# SPORTS_MAX_DRAWDOWN_PCT=0.30
# Peak-DD only after peak ≥ $10 and ≥15 settled (avoids tiny-sample false halt).
# SPORTS_PEAK_DD_MIN_PEAK_CENTS=1000
# SPORTS_PEAK_DD_MIN_SETTLED=15
# Ghost opens: 12h missing, or 6h when wallet is fully flat.
# SPORTS_GHOST_RECONCILE_HOURS=12
# SPORTS_GHOST_FLAT_HOURS=6


# -----------------------------------------------------------------------------
# CSL explore sleeve (independent from RN1) — docs/CSL_EXPLORE_PLAN.md
# Default dry-run via: cli.py run --csl-explore
# -----------------------------------------------------------------------------
# CSL_EXPLORE_ORDER_USDC=1.01
# CSL_EXPLORE_WEEK_BUDGET_USDC=8.08
# CSL_EXPLORE_MAX_PER_MATCH_USDC=1.01
# CSL_EXPLORE_ENABLED_STRATS=fingerprint,time_lag,completeness,narrative,anti_whale
# Optional dog basket: add dog_basket to ENABLED_STRATS
# CSL_EXPLORE_FINGERPRINT_SCORE=1-1
# CSL_EXPLORE_COMPLETENESS_MIN_GAP=0.03
# CSL_EXPLORE_TIME_LAG_DRAW_MINUTE=70
# CSL_EXPLORE_ANTI_WHALE_DROP_PCT=0.08
# Override week fixtures (comma-separated event slugs):
# CSL_EXPLORE_EVENT_SLUGS=chi-wsz-qin-2026-09-05,chi-ygb-hai-2026-09-05,...
# Discord webhook logs (shared DELPHI_ALERT_WEBHOOK_URL); tagged 🧪 CSL Explore + strategy id
# POLYMARKET_CSL_DISCORD=true
# POLYMARKET_CSL_DISCORD_COOLDOWN_S=60
# Stop-loss −50% mark vs entry (limit sell). No auto take-profit.
# CSL_EXPLORE_STOP_LOSS_PCT=0.50
# CSL_EXPLORE_EXIT_FAIL_COOLDOWN_S=1800


# -----------------------------------------------------------------------------
# Performance monitoring (internal telemetry, not third-party)
# -----------------------------------------------------------------------------
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_LOG_INTERVAL_MINUTES=15
